#!/bin/bash
set -euo pipefail

APP_DIR="/usr/local/lib/tiny-llm"
VENV="$APP_DIR/.venv"

find_python() {
  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
      echo "$candidate"
      return 0
    fi
  done
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
    command -v python3
    return 0
  fi
  return 1
}

usage() {
  cat <<'EOF'
Tiny LLM local runner

Usage:
  tiny-llm setup
  tiny-llm train CORPUS.txt [training options]
  tiny-llm generate CHECKPOINT.pt [generation options]

Run `tiny-llm setup` once to create an isolated Python environment and install PyTorch.
EOF
}

if [[ $# -eq 0 ]]; then usage; exit 0; fi
command_name="$1"
shift

if [[ "$command_name" == "setup" ]]; then
  if ! python_path="$(find_python)"; then
    echo "Python 3.10 or newer is required. Install it from https://www.python.org/downloads/macos/ and run this command again." >&2
    exit 1
  fi
  "$python_path" -m venv "$VENV"
  "$VENV/bin/python" -m pip install --upgrade pip
  "$VENV/bin/python" -m pip install -r "$APP_DIR/requirements.txt"
  echo "Tiny LLM is ready. Try: tiny-llm train corpus.txt --steps 3000 --out model.pt"
  exit 0
fi

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "Runtime not set up. Run: tiny-llm setup" >&2
  exit 1
fi

case "$command_name" in
  train) exec "$VENV/bin/python" "$APP_DIR/train.py" "$@" ;;
  generate) exec "$VENV/bin/python" "$APP_DIR/generate.py" "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command_name" >&2; usage >&2; exit 2 ;;
esac
